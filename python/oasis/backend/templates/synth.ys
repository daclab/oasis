# Generated by OASIS. Yosys synthesis of `@@TOP@@` for Xilinx @@FAMILY@@: cell counts only.
# Like Vivado's out-of-context run: the kernel's memories are ports, and no I/O or clock
# buffers are inserted (-noiopad -noclkbuf). -flatten gives one total for the whole design.
read_verilog -sv @@DESIGN_SV@@
synth_xilinx -family @@FAMILY@@ -top @@TOP@@ -noiopad -noclkbuf -flatten
tee -o stat.json stat -json
